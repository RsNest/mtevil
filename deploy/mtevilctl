#!/usr/bin/env bash
set -euo pipefail

resolve_self_dir() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

SELF_DIR="$(resolve_self_dir)"

if [[ -z "${MTEVIL_DIR:-${MTVEIL_DIR:-}}" ]]; then
  if [[ -f "${SELF_DIR}/compose.yaml" && -f "${SELF_DIR}/config.json" ]]; then
    MTEVIL_DIR="$SELF_DIR"
  elif [[ -f "$HOME/mtevil/compose.yaml" ]]; then
    MTEVIL_DIR="$HOME/mtevil"
  elif [[ -f "$HOME/mtveil/compose.yaml" ]]; then
    MTEVIL_DIR="$HOME/mtveil"
  else
    MTEVIL_DIR="$HOME/mtevil"
  fi
else
  MTEVIL_DIR="${MTEVIL_DIR:-${MTVEIL_DIR}}"
fi

print_help() {
  cat <<'EOF'
Управление установкой mtevil (mtevilctl)

Команды:
  mtevilctl status            Показать текущую версию, роль, SNI, состояние контейнера, время работы и версию для отката
  mtevilctl link              Показать текущую ссылку для подключения в Telegram (--sni <домен>, --user <имя>, --all, --webproxy)
  mtevilctl sni [домен]       Сменить основной домен маскировки (SNI) с сохранением работы прежних ссылок
  mtevilctl user list         Показать список дополнительных пользователей
  mtevilctl user add <имя>    Добавить пользователя и сразу вывести его персональную ссылку (без перезапуска контейнера)
  mtevilctl user del <имя>    Удалить пользователя (без перезапуска контейнера)
  mtevilctl adtag show        Показать статус рекламного тега ME (маскированно, без вывода полного значения)
  mtevilctl adtag set         Установить 32-hex ad_tag от @MTProxybot (рекомендуемый скрытый ввод без истории shell; права 0600, без рестарта)
  mtevilctl adtag clear       Удалить рекламный тег (без перезапуска контейнера)
  mtevilctl egress list       Показать узлы egress, стратегию и задержку хеджирования (на узле edge)
  mtevilctl egress add <адр>  Проверить и добавить резервный/основной egress (IP:PORT или wss://host/path)
  mtevilctl egress del <адр>  Удалить узел egress из списка (на узле edge)
  mtevilctl egress hedge <мс> Задать задержку хеджирования egress_hedge_ms в мс (например, 250; 0 — выкл)
  mtevilctl egress strategy <ordered|round-robin>
                              Переключить стратегию выбора egress
  mtevilctl egress check      Выполнить проверку check-egress всех настроенных узлов выхода
  mtevilctl tuning            [experimental] Показать или настроить параметры TCP MSS (--handshake-mss <88..1460|off>, --bulk-mss <88..1460|off>)
  mtevilctl setup             Запустить интерактивный мастер перенастройки (--self-steal, --webproxy [--managed-caddy|--cdn experimental], --shared-443; псевдоним: reconfigure)
  mtevilctl update            Обновить контейнер до свежего стабильного релиза (--proxy-protocol-allow-from <CIDR>)
  mtevilctl update --prerelease
                              Обновить контейнер с учётом предварительных релизов (alpha/beta/rc)
  mtevilctl rollback          Вернуть предыдущую рабочую версию и конфигурацию локально (без интернета)
  mtevilctl traffic           Показать активные сессии, принятые/отправленные байты по участкам и период счётчиков
  mtevilctl traffic --live    Обновлять статистику каждую секунду (скорость приёма/отдачи, отключения, ретрансмиссии TCP; выход по Ctrl+C)
  mtevilctl traf [--live]     Короткий псевдоним для команды traffic
  mtevilctl --help            Показать эту справку

Примеры использования:
  mtevilctl status
  mtevilctl link
  mtevilctl link --sni ya.ru
  mtevilctl sni ya.ru
  mtevilctl user add phone
  mtevilctl setup
  mtevilctl update
  mtevilctl rollback
  mtevilctl traf --live
  MTEVIL_DIR=~/mtevil-edge mtevilctl status

Переменные окружения:
  MTEVIL_DIR      Каталог установки (по умолчанию ~/mtevil)
  MTEVIL_CHANNEL  Канал релизов для update: stable (по умолчанию) или prerelease
  MTEVIL_VERSION  Целевая версия для update (переопределяет канал и выбирает указанный тег)
EOF
}

CMD="${1:-}"
case "$CMD" in
  -h|--help|help)
    print_help
    exit 0
    ;;
  "")
    print_help
    exit 1
    ;;
  status|update|rollback|traffic|traf|link|sni|user|adtag|egress|tuning|setup|reconfigure)
    shift
    for arg in "$@"; do
      if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        print_help
        exit 0
      fi
    done
    SETUP_PY="${MTEVIL_DIR}/setup.py"
    if [[ ! -f "$SETUP_PY" && -f "${SELF_DIR}/setup.py" ]]; then
      SETUP_PY="${SELF_DIR}/setup.py"
    fi
    if [[ ! -f "$SETUP_PY" ]]; then
      echo "Ошибка: не найден файл ${SETUP_PY}." >&2
      echo "Укажите каталог установки через MTEVIL_DIR или выполните первичную установку." >&2
      exit 1
    fi
    exec python3 "$SETUP_PY" "$CMD" --dir "$MTEVIL_DIR" "$@"
    ;;
  *)
    echo "Неизвестная команда: $CMD" >&2
    echo "Используйте 'mtevilctl --help' для просмотра списка команд." >&2
    exit 1
    ;;
esac
